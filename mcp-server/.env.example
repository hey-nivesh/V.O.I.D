# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-prod
# Use 24h or more for long-running fix-agent; match server default in src/index.ts
JWT_EXPIRES_IN=24h

# Database
DB_PATH=./data/void.db

# Monorepo root (so MCP reads the same v.o.i.d/approval.json as fix-agent for orchestrator push gate UI)
# VOID_WORKSPACE_ROOT=E:\VOID\V.O.I.D
# Or set explicit file: VOID_APPROVAL_JSON_PATH=E:\VOID\V.O.I.D\v.o.i.d\approval.json

# Server
PORT=3000
HOST=0.0.0.0

# CORS
CORS_ORIGIN=http://localhost:8080

# Cloudflare Tunnel (optional)
CLOUDFLARED_TOKEN=
CLOUDFLARED_TUNNEL_NAME=void-demo
MCP_URL=http://localhost:3000

# Webhook (optional)
WEBHOOK_URL=
