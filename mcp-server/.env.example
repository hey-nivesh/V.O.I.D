# JWT Configuration
JWT_SECRET=your-super-secret-key-change-in-prod
JWT_EXPIRES_IN=1h

# Database
DB_PATH=./data/void.db

# Server
PORT=3000
HOST=0.0.0.0

# CORS
CORS_ORIGIN=http://localhost:8080

# Zone 3: Sherlock-Zero RCA Engine (optional — uses heuristic fallback if not set)
GEMINI_API_KEY=

# Cloudflare Tunnel (optional)
CLOUDFLARED_TOKEN=
CLOUDFLARED_TUNNEL_NAME=void-demo
MCP_URL=http://localhost:3000

# Zone 6: Webhook on ticket approval (optional — for CI/CD integration)
WEBHOOK_URL=
