# Lines must be KEY=value or # comments — do not paste prose without # (breaks VOID_MCP_URL).
# MCP server for ticket stream / submit_fix
# VOID_MCP_URL=http://localhost:3000
# Must match mcp-server seed users (default fixagent / fixpass)
# FIXAGENT_USERNAME=fixagent
# FIXAGENT_PASSWORD=fixpass

# Optional: load RCA JSON from disk when the ticket has no user_context.rca
# VOID_RCA_JSON_PATH=E:\\VOID\\V.O.I.D\\fix-agent\\rca-handover.example.json
# If unset, ./rca-handover.example.json next to cwd is used when the file exists (set VOID_SKIP_DEFAULT_RCA=1 to disable)

# How often to re-check PENDING tickets (ms). 0 = only on agent startup. Default 45000.
# VOID_PENDING_POLL_MS=45000

# Git repo where fixes are applied (overrides gatekeeper_context.sandbox_path)
# VOID_TARGET_REPO=E:\\VOID\\V.O.I.D\\Focus-Flow-

# Sparse-checkout hides all files except relevant_paths — default is OFF so your clone stays full.
# VOID_USE_SPARSE_CHECKOUT=1

# Recover a clone that only shows a few files after sparse-checkout: npm run recover-repo -- "E:\\path\\to\\Focus-Flow-"

# --- AI Engineering Orchestrator (Cline worker → senior gate → git push) ---
# VOID_ORCHESTRATOR_MODE=1
# VOID_FOCUS_FLOW_ROOT=E:\\VOID\\V.O.I.D\\Focus-Flow-
# VOID_CLINE_URL=http://localhost:25463
# VOID_ORCH_VERIFY_CMD=npm run build
# If package.json is not at repo root (nested `Focus-Flow-/Focus-Flow-` is preferred over `Focus Flow/`). Override:
# VOID_ORCH_NPM_CWD=E:\\VOID\\V.O.I.D\\Focus-Flow-\\Focus-Flow-
# After Cline finishes, touch: Focus-Flow-\\.void\\orchestrator\\CLINE_READY_<ticketId>
# Senior approval file (first line must contain "Approved"): .void\\orchestrator\\approval-<sanitizedId>
# VOID_ORCH_SKIP_CLINE_WAIT=1
# VOID_ORCH_SKIP_APPROVAL=1
# VOID_ORCH_APPROVAL_TIMEOUT_MS=86400000
# VOID_SENIOR_WEBHOOK_URL=

# Shown in handover hyper_context; optional override path for product app
# VOID_DEFAULT_PRODUCT_REPO=E:\\VOID\\V.O.I.D\\Focus-Flow-

# Extra sentence appended to the default Focus-Flow- product scope
# VOID_PRODUCT_FIX_CONTEXT=

# Set to 1 to skip injecting default Focus-Flow- scope into every handover
# VOID_PRODUCT_FIX_SCOPE_DISABLE=

# Optional: shell command run in VOID_TARGET_REPO before verification (e.g. an LLM fixer)
# VOID_FIX_COMMAND=

# VOID_DEBUG_RCA=1

# --- approval.json gate (git push) — shared with cline-void startVoidFix ---
# Default file: <workspace>/v.o.i.d/approval.json  (set VOID_WORKSPACE_ROOT=E:\\VOID\\V.O.I.D)
# VOID_APPROVAL_JSON_PATH=E:\\VOID\\V.O.I.D\\v.o.i.d\\approval.json
# Poll every 10s until status is "approved". Set status to "rejected" to block.
# VOID_SKIP_APPROVAL_JSON=1
# VOID_APPROVAL_TIMEOUT_MS=86400000
# GEMINI_API_KEY=
# Triage-Envoy (S2R manifests): optional model override
# GEMINI_TRIAGE_MODEL=gemini-2.0-flash

# Workspace root for v.o.i.d/.void/incidents/S2R_*.json (defaults to parent of fix-agent cwd)
# VOID_WORKSPACE_ROOT=E:\\VOID\\V.O.I.D

# --- Raise a ticket manually (voice agent) with Focus-Flow- user concern ---
# Ticket title/description + user_context are merged into the RCA handover for the fix agent.
# Use component e.g. FocusFlow; priority LOW|MEDIUM|HIGH|CRITICAL.
#
# $r = Invoke-RestMethod -Method Post -Uri http://localhost:3000/auth/login -ContentType "application/json" -Body '{"username":"voice","password":"voicepass"}'
# $token = $r.data.token
# $bodyObj = [ordered]@{
#   title = 'Search + filter shows no results (Focus-Flow-)'
#   description = 'User on local app: after typing in search and applying a filter, the list is empty even when matches should exist.'
#   component = 'FocusFlow'
#   priority = 'HIGH'
#   user_context = @{
#     user_concern = 'Combined search query and filter should narrow results, not clear them incorrectly.'
#     area = 'search'
#     product = 'Focus-Flow- (local workspace clone)'
#     steps_to_reproduce = 'Open app → enter search text → apply filter → observe empty list'
#     relevant_paths = @('src')
#   }
# }
# $body = $bodyObj | ConvertTo-Json -Depth 8
# Invoke-RestMethod -Method Post -Uri http://localhost:3000/api/tickets -Headers @{ Authorization = "Bearer $token" } -ContentType "application/json" -Body $body